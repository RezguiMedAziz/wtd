# Base URL of the FastAPI backend (see ../backend)
VITE_API_BASE_URL=/api
DATABASE_URL=postgresql://wtd_user:admin@localhost=:5432/wtd
# Background removal for uploaded stickers:
#   api     (default) -> done by the backend with rembg
#   browser           -> offline fallback, runs in the browser (model downloads on first use)
VITE_BG_REMOVAL_MODE=api
VITE_BG_REMOVAL_PUBLIC_PATH=
VITE_API_URL=https://xyz789.ngrok-free.app
