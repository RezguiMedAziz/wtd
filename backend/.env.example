# Copy to .env and adjust.
DATABASE_URL=postgresql://wtd_user:admin@localhost:5432/wtd
# Comma-separated list of frontend origins allowed by CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Public URL of this API (used to build image links returned to the frontend)
PUBLIC_BASE_URL=http://localhost:8000
MEDIA_DIR=./media
MAX_UPLOAD_MB=12
MAX_UPLOADS_PER_SESSION=15
# rembg model: u2netp (default, tiny ~5 MB), u2net (better quality, ~170 MB download on first use), isnet-general-use
REMBG_MODEL=u2netp
